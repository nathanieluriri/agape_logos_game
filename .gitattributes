# Line-ending normalization.
# The repository stores text files with LF. Git normalizes on commit and
# checks out LF, so editors or tools that rewrite files to CRLF no longer
# show the whole tree as "modified" (and uncommitted fixes stop reverting).
* text=auto eol=lf

# Explicit text types (belt and suspenders).
*.dart       text eol=lf
*.md         text eol=lf
*.json       text eol=lf
*.yaml       text eol=lf
*.yml        text eol=lf
*.ts         text eol=lf
*.js         text eol=lf
*.html       text eol=lf
*.css        text eol=lf
*.svg        text eol=lf
*.xml        text eol=lf
*.gradle     text eol=lf
*.kts        text eol=lf
*.properties text eol=lf
*.pro        text eol=lf
gradlew      text eol=lf

# Windows batch scripts must keep CRLF.
*.bat        text eol=crlf

# Binary assets: never touch line endings.
*.png    binary
*.jpg    binary
*.jpeg   binary
*.gif    binary
*.ico    binary
*.webp   binary
*.otf    binary
*.ttf    binary
*.woff   binary
*.woff2  binary
*.jar    binary
*.keystore binary
*.wasm   binary
*.zip    binary
